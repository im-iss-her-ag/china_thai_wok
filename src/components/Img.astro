---
/**
 * Bild aus src/assets/images/<name>.(jpg|jpeg|png|webp).
 * Fehlt die Datei, wird ein warmer Farbverlauf als Platzhalter gezeigt.
 * Bild austauschen = Datei mit gleichem Namen ersetzen.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
  variant?: string;
  /** 'span' für Bilder innerhalb von Fließtext (<p>) */
  tag?: 'div' | 'span';
}
const { name, alt, widths = [480, 800, 1200, 1600], sizes = '100vw', eager = false, class: cls = '', variant = '', tag: Tag = 'div' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const hit = Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.[^.]+$/, '') === name);
const src = hit?.[1].default;
---
<Tag class:list={['ph', variant, cls]}>
  {src && (
    <Image
      src={src}
      alt={alt}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      format="webp"
      quality={72}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  )}
</Tag>
