---
import '../styles/global.css';
import Sprite from '../components/Sprite.astro';
import { site, notice, R, social } from '../lib/site';
import { SLOTS, OPEN_DAYS, SCHEMA_DAYS } from '../lib/hours';
import { getImage } from 'astro:assets';
import ogSrc from '../assets/images/hero-wok.jpg';
// Hauptschrift vorladen → kein sichtbarer Schriftwechsel (FOUT) beim ersten Aufruf
import fontUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  page?: 'home' | 'menu' | 'legal';
  jsonld?: object[];
  noindex?: boolean;
}
const { title, description, page = 'home', jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: ogSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

const restaurant = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': new URL('/#restaurant', Astro.site).href,
  name: site.name,
  description: site.slogan,
  url: new URL('/', Astro.site).href,
  image: ogUrl.href,
  telephone: R.phoneE164,
  servesCuisine: ['Chinesisch', 'Thailändisch', 'Asiatisch'],
  priceRange: '€',
  acceptsReservations: false,
  hasMenu: new URL('/speisekarte/', Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.zip, addressLocality: site.city, addressCountry: 'DE' },
  openingHoursSpecification: SLOTS.map((s) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: OPEN_DAYS.map((d) => SCHEMA_DAYS[d]), opens: s.from, closes: s.to })),
  sameAs: [social.googleUrl, social.instagram].filter(Boolean),
};
const nav = [
  { href: '/', t: 'Startseite', s: 'Startseite', key: 'home' },
  { href: '/speisekarte/', t: 'Speisekarte', s: 'Speisekarte', key: 'menu' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#0E2B25" />
  <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content="restaurant" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify([restaurant, ...jsonld])} />
  <script is:inline>
    (function (d) {
      d.classList.add('js');
      try {
        if (location.pathname === '/' && !sessionStorage.getItem('ctw-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('intro');
      } catch (e) {}
    })(document.documentElement);
  </script>
</head>
<body class={page === 'home' ? 'is-home' : ''}>
  <a class="skip" href="#main">Zum Inhalt springen</a>
  <Sprite />
  <div class="grain" aria-hidden="true"></div>
  <div class="cur" aria-hidden="true"><span>ANSEHEN</span></div><div class="cur-dot" aria-hidden="true"></div>

  {page === 'home' && (
    <div class="curtain" id="curtain" aria-hidden="true" hidden>
      <span class="door l"></span><span class="door r"></span>
      <span class="seam"></span>
      <div class="cmark"><div><b><span>{site.name}</span></b><i class="cline"></i><small>{site.city}</small></div></div>
    </div>
  )}

  <div class="sprog" aria-hidden="true"></div>
  <header class="hdr" id="hdr">
    <div class="wrap">
      <a class="brand" href="/" aria-label={`${site.name}, ${site.street}, ${site.city} – Startseite`}><span class="bn">{site.name}</span><small>{site.street} · {site.city}</small></a>
      <nav aria-label="Hauptnavigation" class={`hnav p-${page === "menu" ? 2 : page === "home" ? 1 : 0}`}><span class="nav-ind" aria-hidden="true"></span>
        {nav.map((n) => <a href={n.href} aria-current={page === n.key ? 'page' : undefined}><span class="l" data-t={n.t}>{n.t}</span><span class="m">{n.s}</span></a>)}
      </nav>
      <span class="ost hdr-ost" data-open-status hidden><i></i><span data-t></span></span>
      <a class="btn call" href={site.tel} data-mag><span>{site.phone}</span><span class="ic"><svg><use href="#i-phone" /></svg></span><span class="sr-only">Anrufen</span></a>
    </div>
  </header>

  <main id="main">
    {notice && <div class="notice" role="status"><b>Hinweis</b>{notice}</div>}
    <slot />
  </main>

  <footer class="foot">
    <svg class="cloud cl drift cl-fa" aria-hidden="true"><use href="#cl-a" /></svg>
    <svg class="cloud cl drift r cl-fb" aria-hidden="true"><use href="#cl-b" /></svg>
    <div class="wrap">
      <span class="kicker c-gold">Hunger?</span>
      <div class="cta"><a class="tel" href={site.tel} data-hover="ANRUFEN">{site.phone}</a><a class="btn" href="/speisekarte/" data-mag><span>Speisekarte</span><span class="ic"><svg><use href="#i-arrow" /></svg></span></a></div>
      <div class="cols">
        <div><h2>Adresse</h2><p>{site.name}<br />{site.street}<br />{site.zip} {site.city}</p><p class="foot-links"><a href={site.mapsUrl} target="_blank" rel="noopener">Route planen →</a><a href={social.googleUrl} target="_blank" rel="noopener">Google-Bewertungen →</a>{social.instagram && <a href={social.instagram} target="_blank" rel="noopener">Instagram →</a>}</p></div>
        <div><h2>Öffnungszeiten</h2><p>Di – So · 10:30 – 15:00<br />und 17:00 – 21:30<br />Mo Ruhetag (an Feiertagen geöffnet)</p><span class="ost foot-ost" data-open-status hidden><i></i><span data-t></span></span><p class="foot-links"><a href={site.menuPdf} download>Speisekarte als PDF ↓</a></p></div>
        <div><h2>Lieferservice</h2><p>{site.delivery.hours}<br />Mindestbestellwert {site.delivery.min} € in {site.city}<br />ab {site.delivery.promoFrom} €: 1 Flasche Wein gratis</p></div>
      </div>
      <div class="word" aria-hidden="true">{site.name}</div>
      <div class="bot"><span>© {year} {site.name} · Inh. {R.owner}</span><span><a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a></span></div>
    </div>
  </footer>


  <script>
    import '../scripts/main.ts';
  </script>
</body>
</html>
