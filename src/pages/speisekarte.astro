---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, R, categories, additives, allergens, sauces, euro, dishCount, shortName, signature, dishKey, catIntro } from '../lib/site';

/* ---------- Bilder je Gericht (src/assets/images/gerichte/<key>.jpg) ---------- */
const dishFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/gerichte/*.{jpg,jpeg,png,webp}', { eager: true });
const dishImg: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(dishFiles).map(([p, m]) => [p.split('/').pop()!.replace(/\.[^.]+$/, '').toLowerCase(), m.default]),
);
type Pic = { thumb: string; thumb2: string; big: string };
const pics: Record<string, Pic> = {};
for (const c of categories) for (const d of c.items) {
  const k = dishKey(d), meta = dishImg[k];
  if (!meta || pics[k]) continue;
  const [t1, t2, big] = await Promise.all([
    getImage({ src: meta, width: 200, height: 200, fit: 'cover', format: 'webp', quality: 70 }),
    getImage({ src: meta, width: 400, height: 400, fit: 'cover', format: 'webp', quality: 68 }),
    getImage({ src: meta, width: 960, height: 720, fit: 'cover', format: 'webp', quality: 74 }),
  ]);
  pics[k] = { thumb: t1.src, thumb2: t2.src, big: big.src };
}

const sigNrs = new Set(signature.map((s) => s.dish.nr));
const strip = (t: string) => t.replace(/^mit\s+/i, '');
const allergenNames = (d: { allergens: string[] }) => d.allergens.map((k) => allergens[k]).filter(Boolean);
const additiveNames = (d: { additives: string[] }) => d.additives.map((k) => additives[k] && strip(additives[k])).filter(Boolean);
const shortAll: Record<string, string> = { e: 'Gluten', g: 'Soja', k: 'Sesam' };
const cardAll = (d: { allergens: string[] }) => d.allergens.map((k) => shortAll[k] ?? allergens[k]).filter(Boolean).join(', ');
const cardAdd = (d: { additives: string[] }) => additiveNames(d).join(', ').replace('Geschmacksverstärker', 'Geschmacks\u00ADverstärker').replace('Konservierungsstoff', 'Konservierungs\u00ADstoff');
const catTitle = (n: string) => n.replace(/\s*\(.*\)$/, '');
/* Übersicht: je Kategorie Bild (erstes Gericht mit Foto), Anzahl, Preis ab */
const overview = categories.map((c) => {
  const withPic = c.items.find((d) => pics[dishKey(d)]);
  return {
    id: c.id, name: shortName[c.id] ?? catTitle(c.name), n: c.items.length,
    from: euro(Math.min(...c.items.map((d) => d.price))),
    img: withPic ? pics[dishKey(withPic)].thumb : null,
  };
});
const sideNote = 'Mit Reis – oder mit gebratenen Nudeln (+3,00 €)';
/* Codes wie "1,4,7,c,e,g" → lesbarer Text (Allergene · Zusatzstoffe) */
const splitCodes = (codes: string | null | undefined) => (codes ?? '').split(',').map((x) => x.trim()).filter(Boolean);
const codeText = (codes: string | null | undefined) => {
  const cs = splitCodes(codes);
  const al = cs.filter((x) => allergens[x]).map((x) => allergens[x]);
  const ad = cs.filter((x) => additives[x]).map((x) => strip(additives[x]));
  return [al.join(', '), ad.join(', ')].filter(Boolean).join(' · ');
};
const sideText = (c: { categoryCodes: string | null }) => {
  const al = splitCodes(c.categoryCodes).filter((x) => allergens[x]).map((x) => allergens[x]);
  return al.length ? `${sideNote}. Gebratene Nudeln enthalten: ${al.join(', ')}.` : sideNote;
};
const validFrom = R.menuValidFrom ? new Date(R.menuValidFrom + 'T12:00:00').toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }) : null;
const anchor = (d: { nr: string | null }, k: string) => 'gericht-' + k;

/* Daten für die Detail-Karte (Sheet) – alle Details (Soßen, Allergene, Zusatzstoffe) nur dort */
const sheetData = categories.map((c) => ({
  cat: catTitle(c.name),
  side: c.note?.startsWith('mit Reis') ? sideText(c) : null,
  items: c.items.map((d) => {
    const k = dishKey(d);
    return {
      nr: d.nr, name: d.name, desc: d.description, price: euro(d.price), size: d.size ?? null,
      spicy: d.spicy, veg: !!d.vegetarian, sig: sigNrs.has(d.nr), out: !!d.soldOut,
      img: pics[k]?.big ?? null, id: anchor(d, k),
      all: allergenNames(d), add: additiveNames(d),
      sauces: (c.id === 'udon' || d.sauceChoice) ? (d.sauceChoice ?? Object.keys(sauces)).map((s) => ({ k: s, name: sauces[s]?.name, spicy: sauces[s]?.spicy ?? null, info: codeText(sauces[s]?.codes) })) : null,
    };
  }),
}));

/* ---------- SEO: strukturierte Daten ---------- */
const pageUrl = new URL('/speisekarte/', Astro.site).href;
const menuLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  '@id': pageUrl + '#menu',
  name: `Speisekarte ${site.name}`,
  url: pageUrl,
  inLanguage: 'de',
  hasMenuSection: categories.map((c) => ({
    '@type': 'MenuSection',
    name: catTitle(c.name),
    url: pageUrl + '#' + c.id,
    ...(catIntro[c.id] ? { description: catIntro[c.id] } : {}),
    hasMenuItem: c.items.map((d) => {
      const k = dishKey(d);
      return {
        '@type': 'MenuItem',
        name: d.nr ? `${d.nr} ${d.name}` : d.name,
        url: pageUrl + '#' + anchor(d, k),
        ...(d.description ? { description: d.description } : {}),
        ...(pics[k] ? { image: new URL(pics[k].big, Astro.site).href } : {}),
        ...(d.vegetarian ? { suitableForDiet: 'https://schema.org/VegetarianDiet' } : {}),
        offers: { '@type': 'Offer', price: d.price.toFixed(2), priceCurrency: 'EUR', availability: d.soldOut ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock' },
      };
    }),
  })),
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Speisekarte', item: pageUrl },
  ],
};
---
<Base
  title={`Speisekarte – ${site.name} ${site.city} | China, Thai & Wok`}
  description={`Speisekarte von ${site.name} in ${site.city}: ${dishCount} Gerichte mit Bild und Preis – knusprige Ente, Huhn, Thai-Curry, Udon, Wok-Nudeln & vegetarisch. Abholung & Lieferung.`}
  page="menu"
  jsonld={[menuLd, crumbs]}
>
  <section class="pagehero">
    <svg class="cloud drift" aria-hidden="true"><use href="#cl-a" /></svg>
    <svg class="cloud b drift r" aria-hidden="true"><use href="#cl-b" /></svg>
    <div class="wrap">
      <span class="kicker c-gold">{dishCount} Gerichte · {categories.length} Kategorien</span>
      <h1>Unsere <span class="it">Speisekarte</span></h1>
      <p>Chinesische und thailändische Küche aus dem Wok – alle Hauptgerichte mit Reis oder gebratenen Nudeln (+3,00 €). Zum Mitnehmen oder geliefert: <a class="lnk-gold" href={site.tel}>{site.phone}</a>.</p>
      <div class="btn-row">
        <a class="btn" href={site.menuPdf} download><span>Speisekarte als PDF</span><span class="ic"><svg><use href="#i-download" /></svg></span></a>
        <a class="btn ghost c-rice" href={site.menuPdf} target="_blank" rel="noopener">Ansehen &amp; drucken</a>
      </div>
    </div>
  </section>

  <!-- Kategorien-Navigation: Tabs mit gleitendem Indikator -->
  <span class="cn-sentinel" aria-hidden="true"></span>
  <nav class="catnav" id="catnav" aria-label="Kategorien der Speisekarte">
    <div class="wrap cn-wrap">
      <button class="cn-arr l" type="button" aria-label="Kategorien nach links" tabindex="-1"><svg class="flip"><use href="#i-arrow" /></svg></button>
      <div class="cn-track" id="cnTrack">
        {categories.map((c, i) => <a class={`cn-link${i === 0 ? ' on' : ''}`} href={`#${c.id}`} aria-current={i === 0 ? 'true' : undefined}>{shortName[c.id] ?? catTitle(c.name)}</a>)}
        <span class="cn-ind" id="cnInd" aria-hidden="true"></span>
      </div>
      <button class="cn-arr r" type="button" aria-label="Kategorien nach rechts" tabindex="-1"><svg><use href="#i-arrow" /></svg></button>
    </div>
  </nav>

  <div class="wrap" id="menu">
    <section class="ov" id="uebersicht" aria-labelledby="ovH">
      <div class="ov-head"><h2 id="ovH">Auf einen Blick</h2><p>{categories.length} Kategorien – tippen Sie auf eine, um direkt dorthin zu springen.</p></div>
      <ul class="ov-grid">
        {overview.map((o) => (
          <li><a class="ov-tile" href={`#${o.id}`}>
            <span class="ov-img" aria-hidden="true">{o.img && <img src={o.img} alt="" width="200" height="200" loading="lazy" decoding="async" />}</span>
            <span class="ov-txt"><b>{o.name}</b><small>{o.n} {o.n === 1 ? 'Gericht' : 'Gerichte'}<span class="sep"> · </span><span class="fr">ab {o.from}</span></small></span>
          </a></li>
        ))}
      </ul>
    </section>
    <div class="tools">
      <label class="srch"><svg aria-hidden="true"><use href="#i-search" /></svg><span class="sr-only">Gericht suchen</span><input id="q" type="search" placeholder="Gericht oder Nummer suchen…" autocomplete="off" /></label>
      <div class="tgls" role="group" aria-label="Filter">
        <button class="tgl v" id="tV" type="button" aria-pressed="false"><svg aria-hidden="true"><use href="#i-leaf" /></svg>Vegetarisch</button>
        <button class="tgl h" id="tH" type="button" aria-pressed="false"><svg aria-hidden="true"><use href="#i-chili" /></svg>Scharf</button>
      </div>
    </div>

    {categories.map((c, ci) => (
      <section class="mcat" id={c.id} aria-labelledby={`h-${c.id}`}>
        <header class="mc-head">
          <span class="mc-no" aria-hidden="true">{String(ci + 1).padStart(2, '0')}</span>
          <div class="mc-title">
            <h2 id={`h-${c.id}`}>{catTitle(c.name)}</h2>
            {catIntro[c.id] && <p>{catIntro[c.id]}</p>}
          </div>
          <div class="mc-meta">
            <span>{c.items.length} {c.items.length === 1 ? 'Gericht' : 'Gerichte'}</span>
            {c.note?.startsWith('mit Reis') && <span class="mc-side">mit Reis · Nudeln +3,00 €</span>}
            {c.name.includes('(') && !c.note?.startsWith('mit Reis') && <span class="mc-side">{c.name.match(/\((.*)\)/)?.[1]}</span>}
          </div>
        </header>

        <div class="dgrid">
          {c.items.map((d, di) => {
            const k = dishKey(d), pic = pics[k], hot = !!d.spicy, sig = sigNrs.has(d.nr);
            return (
              <article class={`dcard${d.soldOut ? ' out' : ''}`} id={anchor(d, k)} data-ci={ci} data-di={di} tabindex="0" role="button" aria-haspopup="dialog"
                aria-label={`${d.nr ? 'Nr. ' + d.nr + ', ' : ''}${d.name}, ${euro(d.price)} – Details anzeigen`}
                data-v={d.vegetarian ? '1' : '0'} data-h={hot ? '1' : '0'} data-s={`${d.nr ?? ''} ${d.name} ${d.description ?? ''}`.toLowerCase()}>
                <div class="dc-img">
                  {pic
                    ? <img src={pic.thumb} srcset={`${pic.thumb} 200w, ${pic.thumb2} 400w`} sizes="(max-width: 700px) 104px, 132px" width="200" height="200" alt={d.name} loading="lazy" decoding="async" />
                    : <span class="dc-ph" aria-hidden="true"><svg><use href="#i-bowl" /></svg></span>}
                  {d.nr && <span class="dc-no">{d.nr}</span>}
                </div>
                <div class="dc-txt">
                  <h3>{d.name}{d.size && <small> · {d.size}</small>}</h3>
                  {d.description && <p>{d.description}</p>}
                  {(d.allergens.length > 0 || d.additives.length > 0) && (
                    <dl class="dc-info">
                      {d.allergens.length > 0 && <div><dt>Allergene</dt><dd>{cardAll(d)}</dd></div>}
                      {d.additives.length > 0 && <div><dt>Zusatzstoffe</dt><dd>{cardAdd(d)}</dd></div>}
                    </dl>
                  )}
                  <div class="dc-foot">
                    <data class="dc-pr" value={d.price.toFixed(2)}>{euro(d.price)}</data>
                    {(sig || d.vegetarian || hot || d.soldOut) && (
                      <span class="dc-tags">
                        {sig && <span class="tg s"><svg aria-hidden="true"><use href="#i-flame" /></svg>Empfehlung</span>}
                        {!!d.vegetarian && <span class="tg v"><svg aria-hidden="true"><use href="#i-leaf" /></svg>Vegetarisch</span>}
                        {hot && <span class="tg h"><svg aria-hidden="true"><use href="#i-chili" /></svg>{d.spicy![0].toUpperCase() + d.spicy!.slice(1)}</span>}
                        {!!d.soldOut && <span class="tg o">Heute aus</span>}
                      </span>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}
    <p class="empty" id="empty">Keine Gerichte gefunden. Bitte Filter oder Suche ändern.</p>

    <p class="menu-legal">Abbildungen sind Symbolbilder und zeigen Serviervorschläge. Allergene und Zusatzstoffe stehen bei jedem Gericht; gebratene Nudeln als Beilage enthalten zusätzlich Eier und Sojabohnen. Bei Fragen sprechen Sie uns bitte vor der Bestellung an.{validFrom && <> Speisekarte gültig ab {validFrom}.</>}</p>

    <div class="orn-sep" aria-hidden="true"><svg class="orn ink"><use href="#orn" /></svg></div>
    <section class="legend page-end" id="allergene" aria-labelledby="legH">
      <svg class="cloud sm drift legend-cl" aria-hidden="true"><use href="#cl-c" /></svg>
      <div>
        <h2 id="legH">Zusatzstoffe</h2>
        <ul>{Object.entries(additives).map(([k, v]) => <li><b>{k}</b>{v}</li>)}</ul>
        <p class="legend-note">Bei Fragen zu Allergenen sprechen Sie uns gern an.</p>
      </div>
      <div>
        <h2>Allergene</h2>
        <ul>{Object.entries(allergens).map(([k, v]) => <li><b>{k}</b>{v}</li>)}</ul>
      </div>
    </section>
  </div>

  <script type="application/json" id="dishData" set:html={JSON.stringify(sheetData)} />
  <a class="to-ov" id="toOv" href="#uebersicht" aria-label="Zur Übersicht der Kategorien"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><span>Übersicht</span></a>

  <div class="sheet" id="sheet" hidden>
    <div class="sheet-bg" data-close></div>
    <div class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="shName">
      <span class="sheet-grip" aria-hidden="true"></span>
      <button class="sheet-x" type="button" data-close aria-label="Schließen"><svg><use href="#i-close" /></svg></button>
      <div class="sheet-img"><img id="shImg" alt="" /><span class="sh-no" id="shNo"></span></div>
      <div class="sheet-body">
        <span class="kicker c-gold-ink" id="shCat"></span>
        <h2 id="shName"></h2>
        <p id="shDesc" class="sh-desc"></p>
        <div class="sh-price"><b id="shPrice"></b><span class="sh-badges" id="shBadges"></span></div>
        <p class="sh-side" id="shSide"></p>

        <section class="sh-details" aria-labelledby="shDetH">
          <h3 id="shDetH">Zutaten &amp; Hinweise</h3>
          <div id="shSauces" class="sh-block"></div>
          <div class="sh-block"><h4>Allergene</h4><ul id="shAll" class="chips"></ul></div>
          <div class="sh-block"><h4>Zusatzstoffe</h4><ul id="shAdd" class="chips"></ul></div>
          <p class="sh-note">Bei Allergien oder Unverträglichkeiten fragen Sie uns bitte vor der Bestellung.</p>
        </section>

      </div>
    </div>
  </div>
</Base>
